# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# --- database ---------------------------------------------------
# Read by docker-compose.yml to provision the local container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=""
POSTGRES_DB=splitlink
POSTGRES_PORT=5433

# Read by the app. Must describe the same database as the four vars
# above — nothing enforces that, so change them together.
#   postgresql://<user>:<password>@<host>:<port>/<database>
# Percent-encode the password if it contains @ : / ? # &
# Do NOT append ?schema=public — the driver adapter passes this
# string straight to `pg`, which does not understand it.
DATABASE_URL=""

# --- frontend ---------------------------------------------------
CLIENT_URL="http://localhost:3000"

# --- secrets ----------------------------------------------------
# Generate with: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 44
TOKEN_PEPPER=""

# --- trip lifecycle ---------------------------------------------
SHARE_CODE_LENGTH=12
TRIP_TTL_DEFAULT_HOURS=72
TRIP_TTL_MAX_HOURS=720
PURGE_GRACE_HOURS=24
MAX_MEMBERS_PER_TRIP=25

# --- abuse control ----------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
